# =============================================================
#  MAPS Connect — Variables de entorno requeridas
#  Copia este archivo como .env y rellena los valores reales.
#  NUNCA subas el .env real al repositorio.
# =============================================================

# ── Base de datos ────────────────────────────────────────────
# Desarrollo local: descomenta y ajusta si usas perfil dev
# DB_PASSWORD=tu_password_mysql

# Producción (perfil: prod)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=maps_conect
DB_USER=root
DB_PASSWORD=

# ── JWT ──────────────────────────────────────────────────────
# Mínimo 64 caracteres aleatorios. Genera con:
#   openssl rand -base64 64
JWT_SECRET=CAMBIA_ESTO_POR_UN_SECRETO_SEGURO_DE_AL_MENOS_64_CARACTERES_ALEATORIO
# Expiración en ms: 86400000 = 24h  |  604800000 = 7 días
JWT_EXPIRATION=86400000

# ── CORS ─────────────────────────────────────────────────────
# Orígenes permitidos separados por coma (sin espacio)
# Desarrollo: http://localhost:5500,http://localhost:3000
# Producción: https://app.mapsconect.com
CORS_ORIGINS=http://localhost:5500,http://localhost:3000

# ── Redis (mensajería distribuida entre nodos) ────────────────
# Activa Redis Pub/Sub solo en entornos multi-nodo
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Almacenamiento de archivos ────────────────────────────────
# Opciones: local | s3
STORAGE_TYPE=local
# Si STORAGE_TYPE=local:
STORAGE_LOCAL_DIR=uploads
# Si STORAGE_TYPE=s3:
STORAGE_S3_ENDPOINT=https://s3.amazonaws.com
STORAGE_S3_BUCKET=maps-conect-storage
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=

# ── Perfil de Spring Boot ─────────────────────────────────────
# Opciones: dev | prod
SPRING_PROFILES_ACTIVE=dev
